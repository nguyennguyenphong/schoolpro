# ==============================================================================
# SchoolPro - Global Monorepo Environment Variables
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=schoolpro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:password123@localhost:5433/schoolpro

# Database Management (pgAdmin 4)
PGADMIN_DEFAULT_EMAIL=admin@schoolpro.edu.vn
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Cache & Message Broker (Redis 7)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Backend Service (Django REST Framework)
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-schoolpro-dev-secret-key-change-in-production-12345
BACKEND_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend Service (React + Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
