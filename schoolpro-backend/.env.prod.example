# Production Backend Environment
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-50-character-string
DATABASE_URL=postgres://schoolpro_prod_user:secure_prod_password@db_host:5432/schoolpro_prod
REDIS_URL=redis://redis_host:6379/1
CELERY_BROKER_URL=redis://redis_host:6379/0
CELERY_RESULT_BACKEND=redis://redis_host:6379/0
ALLOWED_HOSTS=api.schoolpro.edu.vn
CORS_ALLOWED_ORIGINS=https://schoolpro.edu.vn,https://app.schoolpro.edu.vn
SECURE_SSL_REDIRECT=True
AXES_ENABLED=True
